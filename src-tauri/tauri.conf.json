{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DietDiary",
  "version": "1.0.0",
  "identifier": "com.jongyu.dietdiary",
  "build": {
    "frontendDist": "../docs"
  },
  "app": {
    "windows": [
      {
        "title": "DietDiary",
        "width": 480,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
